na Zimmermann","term":"Autumn","url":"https://www.vvz.ethz.ch/Vorlesungsverzeichnis/lerneinheit.view?lerneinheitId=194455&semkez=2025W&lang=en","courseType":"Seminar","keywords":["Security & Privacy"]},{"title":"Human-Centered IT Security and Privacy","lecturers":"Verena Zimmermann","term":"Spring","url":"https://www.vvz.ethz.ch/Vorlesungsverzeichnis/lerneinheit.view?lerneinheitId=200275&semkez=2026S&lang=en","courseType":"Elective","keywords":["Security & Privacy"]},{"title":"GIS and Geoinformatics Lab","lecturers":"Peter Kiefer","term":"Autumn","url":"https://www.vvz.ethz.ch/Vorlesungsverzeichnis/lerneinheit.view?lang=en&lerneinheitId=194186&semkez=2025W","courseType":"Seminar","keywords":["Geospatial","AR/VR & Mixed Reality"]},{"title":"Advanced GIS","lecturers":"Martin Raubal, Peter Kiefer","term":"Spring","url":"https://www.vvz.ethz.ch/Vorlesungsverzeichnis/lerneinheit.view?lang=en&lerneinheitId=197940&semkez=2026S","courseType":"Elective","keywords":["Geospatial"]}]}]}],["$","footer",null,{"className":"site-footer","children":["$","div",null,{"className":"site-footer-inner","children":[["$","div",null,{"children":[["$","div",null,{"children":["© ",2026," ETH Zurich · Human-Computer Interaction"]}],["$","div",null,{"children":"Connecting HCI students and researchers across ETH"}]]}],["$","a",null,{"href":"https://forms.gle/if5vx6BPzMqNummD6","target":"_blank","rel":"noreferrer","className":"footer-feedback-link","children":"Share Feedback"}]]}]}]]
